# -----------------------------------------------------------------------------
# Configuração da API
# -----------------------------------------------------------------------------
# Porta onde o servidor irá rodar
PORT=3333

# Ambiente de execução: 'development' (desenvolvimento), 'test' (testes) ou 'production' (produção)
NODE_ENV=development

# -----------------------------------------------------------------------------
# Banco de Dados (PostgreSQL)
# -----------------------------------------------------------------------------
# Endereço do banco. Use 'localhost' se rodar na máquina ou o nome do serviço no Docker
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres

# ! IMPORTANTE: Substitua pelo password do seu banco local
DB_PASSWORD=sua_senha_aqui

# Nome do banco de dados principal
DB_NAME=borala

# Nome do banco de dados utilizado apenas para testes automatizados
DB_NAME_TEST=borala_test

# -----------------------------------------------------------------------------
# Autenticação e Segurança (JWT)
# -----------------------------------------------------------------------------
# Chave secreta para assinar os tokens.
# Dica: Em produção, use uma string longa e aleatória (ex: gere com `openssl rand -base64 32`)
JWT_SECRET=troque_isso_por_um_segredo_forte

# Tempo de expiração do token (ex: '1d' para 1 dia, '1h' para 1 hora)
JWT_EXPIRES_IN=1d