# --- Configuração da API ---
PORT=3333
NODE_ENV=development

# --- Banco de Dados (PostgreSQL) ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres

# ⚠️ ATENÇÃO: Altere a senha e o nome do banco conforme seu ambiente local!
